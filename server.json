{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.Tube2Vid/mcp",
  "title": "Tube2Vid",
  "description": "Download video, audio and images from YouTube, TikTok, Instagram and 1,800+ sites.",
  "websiteUrl": "https://tube2vid.com",
  "repository": {
    "url": "https://github.com/Tube2Vid/mcp",
    "source": "github"
  },
  "version": "1.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@tube2vid/mcp",
      "version": "1.1.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "TUBE2VID_API_KEY",
          "description": "Your tv_live_ API key from https://tube2vid.com/pricing",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "TUBE2VID_API_URL",
          "description": "API origin (default https://tube2vid.com)",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ]
}
